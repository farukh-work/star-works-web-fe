{
  "name": "star-works",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "start": "next start",
    "sitemap": "next-sitemap",
    "extract-blogs": "node scripts/extract-blogs.js",
    "guard": "node scripts/guard.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "build:next": "next build && next-sitemap"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@opennextjs/cloudflare": "^1.20.17",
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.16.0",
    "@sanity/image-url": "^2.2.0",
    "@studio-freight/lenis": "^1.0.42",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "gsap": "^3.15.1",
    "next": "^16.4.6",
    "next-sanity": "^13.4.0",
    "next-sitemap": "^4.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "react-toastify": "^11.2.0",
    "rehype-raw": "^7.0.0",
    "split-type": "^0.3.4",
    "swiper": "^14.4.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^26.6.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "chalk": "^6.0.1",
    "dotenv": "^18.0.10",
    "googleapis": "^190.0.0",
    "postcss": "^8.5.13",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.2.4",
    "turndown": "^7.2.5",
    "wrangler": "^4.163.0"
  },
  "rules": {
    "react/no-unescaped-entities": "off"
  },
  "overrides": {
    "postcss-selector-parser": "^6.1.6",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    },
    "@opennextjs/aws": {
      "glob": "^14.0.6",
      "minimatch": "^11.0.8"
    },
    "@opennextjs/cloudflare": {
      "glob": "^14.0.6",
      "minimatch": "^11.0.8"
    }
  }
}
